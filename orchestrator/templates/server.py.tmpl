"""HTTP MCP server: __NAME__.

    .venv\\Scripts\\python.exe -m __PACKAGE__.server

Generated by mcp-orchestrator. It is managed from there: started hidden at
logon, stopped and restarted by the mcp_* tools, and its stdout and stderr go
to the orchestrator's log for this server. Anything printed here shows up in
``mcp_logs("__NAME__")``, which is the only window a hidden server gets.

Add tools by writing a function and decorating it with ``@server.tool()``. The
docstring is what the model reads to decide whether to call it, so say what the
tool does and when to use it, not how it is implemented.

Claude Code attaches MCP servers only at process startup. After changing the
tools here, restart the server *and* the sessions that use it.
"""

from __future__ import annotations

import os
from typing import Any

from mcp.server.mcpserver import MCPServer

HOST = os.environ.get("__ENV_PREFIX___HOST", "127.0.0.1")
PORT = int(os.environ.get("__ENV_PREFIX___PORT", "__PORT__"))

server = MCPServer(
    "__NAME__",
    instructions="__NAME__ MCP server. Replace this with what it is for.",
)


@server.tool()
def __IDENT___ping(message: str = "hello") -> dict[str, Any]:
    """Check that the __NAME__ server is reachable and echo a message back.

    Replace this with a real tool. It exists so a freshly scaffolded server has
    something callable, which is what proves the whole chain works: process
    started, port open, Claude Code attached.
    """
    return {"ok": True, "server": "__NAME__", "echo": message}


def main() -> None:
    print(f"__NAME__ mcp listening on http://{HOST}:{PORT}/mcp", flush=True)
    server.run(transport="streamable-http", host=HOST, port=PORT)


if __name__ == "__main__":
    main()
